{
  "name": "@software-automation-holdings-llc/sdk",
  "version": "1.1.1-next.366.8cef08c",
  "description": "Unified TypeScript SDK for the ISA platform APIs (zyins, rapidsign, proxy).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Software-Automation-Holdings-LLC/sdk.git",
    "directory": "packages/ts"
  },
  "license": "Apache-2.0",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./zyins": {
      "types": "./dist/zyins/index.d.ts",
      "import": "./dist/zyins/index.js"
    },
    "./zyins/react": {
      "types": "./dist/zyins/react/useZyIns.d.ts",
      "import": "./dist/zyins/react/useZyIns.js"
    },
    "./zyins/vue": {
      "types": "./dist/zyins/vue/useZyIns.d.ts",
      "import": "./dist/zyins/vue/useZyIns.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "MIGRATION.md"
  ],
  "scripts": {
    "gen:catalog": "node scripts/gen-catalog.mjs",
    "prebuild": "node scripts/gen-catalog.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "overrides": {
    "@vitest/mocker": "4.1.12",
    "source-map-js": "1.2.2"
  },
  "devDependencies": {
    "@types/node": "20.19.41",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12",
    "vue": "3.5.43"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.16.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}
