# Allowlist: ignore everything, then re-include what belongs in the repo.
/*

# Tooling / platform contract
!/.github/
!/.gitignore
!/docs/
!/mise.toml
!/renovate.json

# Go module
!/go.mod
!/go.sum
!/*.go

# Project docs / metadata
!/CHANGELOG.md
!/CONTRIBUTING.md
!/MIGRATION.md
!/PUBLIC_API.txt
!/README.md
!/SECURITY.md
!/VERSION

# Source trees
!/account/
!/catalog/
!/codemod-v2/
!/contract/
!/core/
!/packages/
!/proxy/
!/rapidsign/
!/scripts/
!/zyins/
